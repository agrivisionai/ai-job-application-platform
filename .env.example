# ======================================================================
# AI Job Application & Recruiter Networking Platform
# Copy to .env and fill in.  NEVER commit .env.
# Variables marked [CREDENTIAL] need an account or API key you obtain
# yourself. docs/INTEGRATIONS.md states, per integration, what is
# available, what is paid, and what is manual-only.
# ======================================================================

# ---------------------------- Core ----------------------------
APP_NAME=AI Job Application Platform
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
TIMEZONE=America/Detroit
LOG_LEVEL=INFO
LOG_JSON=false

# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-dev-only
# Fernet key used to encrypt OAuth tokens at rest. Generate:
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------- Database ----------------------------
DATABASE_URL=postgresql+psycopg://jobai:jobai@localhost:5432/jobai
# Dev/test without Postgres:
# DATABASE_URL=sqlite+pysqlite:///./data/jobai.db
ENABLE_PGVECTOR=true
EMBEDDING_DIM=1536

# ---------------------------- Redis / Celery ----------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------------------------- Storage ----------------------------
STORAGE_DIR=./data

# ---------------------------- LLM provider ----------------------------
# offline = deterministic, no network, no key (tests + fallback).
LLM_PROVIDER=offline
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.2
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_PROVIDER=offline
EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------- Job sources ----------------------------
# Public, documented, no-auth JSON endpoints - on by default.
SOURCE_GREENHOUSE_ENABLED=true
SOURCE_LEVER_ENABLED=true
SOURCE_ASHBY_ENABLED=true
SOURCE_SMARTRECRUITERS_ENABLED=true
SOURCE_WORKABLE_ENABLED=true
SOURCE_RECRUITEE_ENABLED=true
SOURCE_REMOTEOK_ENABLED=true
SOURCE_ARBEITNOW_ENABLED=true
SOURCE_HIMALAYAS_ENABLED=true
SOURCE_JOBICY_ENABLED=true

# Company board slugs polled on each ATS (comma separated).
GREENHOUSE_BOARDS=anthropic,databricks,stripe,figma,robinhood
LEVER_BOARDS=netflix,palantir,plaid
ASHBY_BOARDS=openai,ramp,linear
SMARTRECRUITERS_COMPANIES=Visa,Square
WORKABLE_ACCOUNTS=
RECRUITEE_COMPANIES=

# Licensed aggregator APIs - need a free-tier or paid key.
SOURCE_ADZUNA_ENABLED=false
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
SOURCE_JOOBLE_ENABLED=false
JOOBLE_API_KEY=
SOURCE_USAJOBS_ENABLED=false
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
SOURCE_THEMUSE_ENABLED=false
THEMUSE_API_KEY=

# Sites with no public jobs API whose terms forbid automated access.
# manual = the platform builds the search URL and an operator checklist;
# a human runs the search and any submission. No other mode is supported.
SOURCE_LINKEDIN_MODE=manual
SOURCE_INDEED_MODE=manual
SOURCE_ZIPRECRUITER_MODE=manual
SOURCE_DICE_MODE=manual
SOURCE_GLASSDOOR_MODE=manual

# ---------------------------- Application automation ----------------------------
APPLICATION_MODE=assisted
AUTO_SUBMIT_ENABLED=false
MIN_MATCH_SCORE_TO_PREPARE=70
MIN_MATCH_SCORE_TO_AUTO_SUBMIT=85
MAX_APPLICATIONS_PER_DAY=20
MAX_APPLICATIONS_PER_WEEK=100
MAX_POSTING_AGE_DAYS=7
JOB_SEARCH_INTERVAL_MINUTES=60

# ---------------------------- Networking ----------------------------
RECRUITER_DISCOVERY_ENABLED=true
MAX_CONNECTION_REQUESTS_PER_DAY=10
MAX_OUTREACH_MESSAGES_PER_DAY=15
OUTREACH_REQUIRES_APPROVAL=true
FOLLOWUP_DAYS=1,5,10

# Optional licensed people-data enrichment for recruiter discovery.
SOURCE_PDL_ENABLED=false
PDL_API_KEY=
SOURCE_HUNTER_ENABLED=false
HUNTER_API_KEY=

# ---------------------------- Email integration ----------------------------
GMAIL_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback
OUTLOOK_ENABLED=false
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:8000/api/v1/oauth/microsoft/callback

# Outbound SMTP for notification email.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# ---------------------------- Notifications ----------------------------
NOTIFY_EMAIL_ENABLED=false
NOTIFY_DASHBOARD_ENABLED=true
NOTIFY_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=

# ---------------------------- Safety rails ----------------------------
AUTOMATION_PAUSED=false
EXTERNAL_ACTIONS_BLOCKED=false
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
RESPECT_ROBOTS_TXT=true
USER_AGENT=JobAI-Personal-Assistant/1.0 (personal job search)
